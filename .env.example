# ==============================================================================
# Neon PostgreSQL Connection Strings
# ==============================================================================
# DATABASE_URL: Pooled connection string (with '-pooler' in the host).
# Used by the Next.js runtime and serverless functions via PgBouncer.
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/erp?sslmode=require"

# DIRECT_URL: Direct unpooled connection string (without '-pooler').
# Used exclusively by Prisma CLI for schema migrations (prisma migrate deploy/dev).
DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/erp?sslmode=require"

# ==============================================================================
# Application Configuration
# ==============================================================================
# Public address of the app, no trailing slash
APP_URL="http://localhost:3000"

# Time zone used to format dates and shifts in the dashboard
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# ==============================================================================
# Email Delivery Service (Resend)
# ==============================================================================
# Optional in development (invitations/resets are printed to the console if omitted)
RESEND_API_KEY=""
EMAIL_FROM="Retail ERP <onboarding@resend.dev>"

# ==============================================================================
# Social Authentication / OAuth (Google, Apple, Microsoft / Outlook)
# ==============================================================================
# Google Cloud Console: Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized redirect URI: https://<domain>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra / Azure Portal / Live: App Registrations
# Authorized redirect URI: https://<domain>/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Apple Developer: Certificates, Identifiers & Profiles -> Service IDs
# Authorized redirect URI: https://<domain>/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""


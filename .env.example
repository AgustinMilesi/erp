# PostgreSQL connection string (for example from Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public address of the app, no trailing slash
APP_URL="http://localhost:3000"

# Resend (https://resend.com/api-keys). Optional in development:
# without it, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Contact <onboarding@resend.dev>"

# Time zone used to show dates in the dashboard
APP_TIMEZONE="America/Argentina/Buenos_Aires"
